  "id": "ai-plugins",
  "bindings": {
    "delivery.tracker": {
      "provider": "backlog"
    }
  },
  "phases": {
    "flow-code": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {
        "agent": "architecture:architect"
      },
      "phase-plan": {
        "agent": "architecture:architect"
      },
      "phase-implement": {},
      "phase-review": {},
      "phase-build-test": {},
      "phase-verify": {
        "app": null
      },
      "phase-spec-check": {
        "skill": "devbook:verify-change"
      },
      "phase-create-pr": {},
      "phase-report-back": {},
      "phase-summary": {}
    },
    "flow-spec": {
      "phase-update-base": {
        "before": [
          "devbook:validate"
        ]
      },
      "phase-scope": {
        "agent": "architecture:architect"
      },
      "phase-drafting:arc42": {
        "agent": "architecture:architect"
      },
      "phase-drafting:domain": {},
      "phase-drafting:tech": {
        "agent": "architecture:architect"
      },
      "phase-drafting:design": {},
      "phase-drafting:ai": {
        "agent": "documentation:documentation"
      },
      "phase-check-review": {},
      "phase-create-pr": {},
      "phase-report-back": {},
      "phase-summary": {}
    }
  },
  "policy": {
    "qa.depth": "skipped",
    "pr.base": "main"
  },
  "gates": [
    {
      "at": "create-pr",
      "when": "before",
      "purpose": "approval",
      "prompt": "Nothing here is pushed or opened as a pull request until asked. Push and open one now?",
      "show": "summary",
      "unattended": "block"
    }
  ],
